{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "THE MODEL",
  "version": "0.1.0",
  "identifier": "com.themodel.keynote",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../keynote",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../keynote",
    "frontendDist": "../../keynote/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "THE MODEL",
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
