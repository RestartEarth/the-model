{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "THE MODEL",
  "version": "0.1.0",
  "identifier": "com.themodel.keynote",
  "build": {
    "beforeDevCommand": "npm run dev --prefix \"../../the-model demo\"",
    "devUrl": "http://localhost:8090",
    "beforeBuildCommand": "npm run build --prefix \"../../the-model demo\"",
    "frontendDist": "../../../the-model demo/dist-the-model"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "THE MODEL",
        "url": "the-model.html?present=1",
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "visible": false,
        "decorations": false,
        "focus": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
