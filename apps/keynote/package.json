{
  "name": "keynote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "build:pack": "tsc --noEmit && vite build --config vite.pack.config.ts",
    "pack:web": "node ../../scripts/pack-web.mjs",
    "preview": "vite preview --config vite.config.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "@react-three/fiber": "^8.17.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
